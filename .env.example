# Copy to `.env.local` and fill in. Vite only exposes VITE_-prefixed variables,
# and inlines every one of them into the client bundle — never put a secret here.

# Which backend to talk to: `mock` (default) or `supabase`.
VITE_DATA_SOURCE=mock

# Make the mock backend behave like a real network, for checking loading and
# error states. Both default to 0.
# VITE_MOCK_LATENCY_MS=350
# VITE_MOCK_FAILURE_RATE=0.15

# Required when VITE_DATA_SOURCE=supabase. Find both under
# Project Settings -> API in the Supabase dashboard. The anon key is safe to
# ship only because row-level security is enabled on every table.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
